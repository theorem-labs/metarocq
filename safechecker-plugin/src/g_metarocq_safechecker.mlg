
DECLARE PLUGIN "rocq-metarocq-safechecker.plugin"

{
open Attributes
open Stdarg
open Pp
open PeanoNat.Nat
open Datatypes
open Extraction
open Tm_util
open Caml_bytestring

let pr_string l =
  (* We allow utf8 encoding *)
  str (caml_string_of_bytestring l)

let check ~opaque_access env evm poly (c, ustate) =
  debug (fun () -> str"Quoting");
  let env = if poly then env else
    let (qs, us), (qcst, ucst) = Evd.sort_context_set evm in
    Environ.push_context_set ~strict:true (us, ucst) @@
    Environ.push_qualities ~rigid:true (qs, qcst) env
  in
  let prog = time (str"Quoting") (Ast_quoter.quote_term_rec ~translate_template:true ~bypass:true ~opaque_access ~with_universes:true env evm) (EConstr.to_constr evm c) in
  let uctx =
    if poly then
      let uctx = Evd.to_universe_context evm in
      let inst, auctx = UVars.abstract_universes uctx in
      Ast_quoter.mkPolymorphic_ctx (Ast_quoter.quote_abstract_univ_context auctx)
    else Ast_quoter.mkMonomorphic_ctx ()
  in
  let check =
    time (str"Checking")
      (Extraction.infer_and_print_template_program_with_guard
        Config0.default_checker_flags
        (* Config0.type_in_type *)
         prog)
      uctx
  in
  match check with
  | Coq_inl s -> Feedback.msg_info (pr_string s)
  | Coq_inr s -> CErrors.user_err (pr_string s)
let quote_with_cache quote env term =
  fst (quote () env (Evd.from_env env) term)

let test_cache_typing_flags env evm c =
  let term = EConstr.to_constr evm c in
  let impredicative_env = Environ.set_impredicative_set true env in
  let predicative_env = Environ.set_impredicative_set false env in
  let cached_context = Ast_quoter.make_template_universe_context () in
  let quote, _ =
    Ast_quoter.quote_term_remember ~universe_context:cached_context
      (fun _ () -> ()) (fun _ _ () -> ())
  in
  let first = quote_with_cache quote impredicative_env term in
  let cached = quote_with_cache quote predicative_env term in
  let fresh_context = Ast_quoter.make_template_universe_context () in
  let fresh_quote, _ =
    Ast_quoter.quote_term_remember ~universe_context:fresh_context
      (fun _ () -> ()) (fun _ _ () -> ())
  in
  let fresh = quote_with_cache fresh_quote predicative_env term in
  if cached = fresh && first <> cached then
    Feedback.msg_info (str "Cache typing-flag regression passed.")
  else
    CErrors.user_err
      (str "Cache reused a quotation across changed typing flags.")

let test_safecheck_rejection ~opaque_access env evm c =
  let term = EConstr.to_constr evm c in
  let prog =
    Ast_quoter.quote_term_rec ~translate_template:true ~bypass:true
      ~opaque_access ~with_universes:true env evm term
  in
  let bad_term =
    Ast_quoter.mkSort
      (Ast_quoter.quote_sort
         (Sorts.make Sorts.Quality.qtype Univ.Universe.type0))
  in
  let bad_name =
    Ast_quoter.quote_kn
      (Names.KerName.make
         (Names.ModPath.MPfile
            (Names.DirPath.make
               [Names.Id.of_string "MetaRocq";
                Names.Id.of_string "Regression"]))
         (Names.Label.of_id (Names.Id.of_string "successor_too_low")))
  in
  let bad_decl =
    Ast_quoter.mk_constant_decl
      (Ast_quoter.mk_constant_body bad_term (Some bad_term)
         (Ast_quoter.mkMonomorphic_ctx ())
         (Ast_quoter.quote_relevance Sorts.Relevant))
  in
  let global_env, quoted_term = prog in
  let bad_program =
    ({ global_env with declarations = (bad_name, bad_decl) :: global_env.declarations },
     quoted_term)
  in
  match
    Extraction.infer_and_print_template_program_with_guard
      Config0.default_checker_flags bad_program (Ast_quoter.mkMonomorphic_ctx ())
  with
  | Coq_inr _ ->
    Feedback.msg_info (str "SafeCheck negative regression passed.")
  | Coq_inl _ ->
    CErrors.user_err
      (str "SafeCheck accepted a successor-too-low quoted declaration.")

}


VERNAC COMMAND EXTEND MetaRocqSafeCheck CLASSIFIED AS QUERY STATE opaque_access
| #[ poly = polymorphic ] [ "MetaRocq" "SafeCheck" constr(c) ] -> {
    let env = Global.env () in
    let evm = Evd.from_env env in
    let c = Constrintern.interp_constr env evm c in
    check env evm poly c
  }
END

VERNAC COMMAND EXTEND MetaRocqTestCacheTypingFlags CLASSIFIED AS QUERY
| [ "MetaRocq" "Test" "Cache" "Typing" "Flags" constr(c) ] -> {
    let env = Global.env () in
    let evm = Evd.from_env env in
    let c, _ = Constrintern.interp_constr env evm c in
    test_cache_typing_flags env evm c
  }
END

VERNAC COMMAND EXTEND MetaRocqTestSafeCheckRejection CLASSIFIED AS QUERY STATE opaque_access
| [ "MetaRocq" "Test" "SafeCheck" "Rejects" constr(c) ] -> {
    let env = Global.env () in
    let evm = Evd.from_env env in
    let c, _ = Constrintern.interp_constr env evm c in
    test_safecheck_rejection env evm c
  }
END


{

let retypecheck_term_dependencies ~opaque_access env gr =
  let typecheck env c = ignore (Typeops.infer env c) in
  let typecheck_constant c =
    let auctx = Environ.constant_context env c in
    let {UVars.quals = qnames; UVars.univs = unames} as names = UVars.AbstractContext.names auctx in
    let dp = Names.DirPath.make [Names.Id.of_string "MetaRocq"; Names.Id.of_string "Retypecheck"] in
    let fake_quality i _ =
      Sorts.Quality.QVar (Sorts.QVar.make_unif "" i)
    in
    let fake_level i _ =
     Univ.Level.make (Univ.UGlobal.make dp "" i)
    in
    let fake_inst = UVars.Instance.of_array (Array.mapi fake_quality qnames, Array.mapi fake_level unames) in
    let cu = (c, fake_inst) in
    let cbody, ctype, cstrs = Environ.constant_value_and_type env cu in
    let env' = Environ.push_context (UVars.UContext.make names (fake_inst, cstrs)) env in
    typecheck env' ctype;
    Option.iter (typecheck env') cbody
  in
  let st = Conv_oracle.get_transp_state (Environ.oracle (Global.env())) in
  let deps = Assumptions.assumptions ~add_opaque:true ~add_transparent:true opaque_access
      st [gr] in
  let process_object k _ty =
    let open Printer in
    match k with
    | Variable id -> debug (fun () -> str "Ignoring variable " ++ Names.Id.print id)
    | Axiom (ax, _) ->
      begin match ax with
        | Constant c -> typecheck_constant c
        | Positive mi -> () (* typecheck_inductive mi *)
        | Guarded (Names.GlobRef.ConstRef c) -> typecheck_constant c
        | Guarded _ -> ()
        | TypeInType c -> ()
        | UIP _ -> ()
      end
    | Opaque c | Transparent c -> typecheck_constant c
  in Printer.ContextObjectMap.iter process_object deps

let kern_check ~opaque_access env evm gr =
  try
    let () = time (str"Rocq kernel checking") (retypecheck_term_dependencies ~opaque_access env) gr in
    Feedback.msg_info (Printer.pr_global gr ++ str " and all its dependencies are well-typed.")
  with e -> raise e
}

VERNAC COMMAND EXTEND MetaRocqRocqCheck CLASSIFIED AS QUERY STATE opaque_access
| [ "MetaRocq" "RocqCheck" global(c) ] -> {
    let env = Global.env () in
    let evm = Evd.from_env env in
    kern_check env evm (Nametab.global c)
  }
END
