
DECLARE PLUGIN "rocq-metarocq-safechecker.plugin"

{
open Attributes
open Stdarg
open Pp
open PeanoNat.Nat
open Datatypes
open Extraction
open Tm_util
open Caml_bytestring

let pr_string l =
  (* We allow utf8 encoding *)
  str (caml_string_of_bytestring l)

(* The production SafeCheck path: quote the term with the template
   translation, then run the extracted checker on the quoted program.  The
   negative fixtures below go through this same function, so what they test is
   what [MetaRocq SafeCheck] does. *)
let safecheck_env env evm poly =
  if poly then env else
    let (qs, us), (qcst, ucst) = Evd.sort_context_set evm in
    Environ.push_context_set ~strict:true (us, ucst) @@
    Environ.push_qualities ~rigid:true (qs, qcst) env

let quote_safecheck_program ~opaque_access env evm term =
  Ast_quoter.quote_term_rec ~translate_template:true ~bypass:true ~opaque_access ~with_universes:true env evm term

(* The translation memo ([trans_memo.ml]) is emptied when the translation
   ends; this also empties it when SafeCheck or a test ends by an exception. *)
let with_trans_memo_reset f = Fun.protect ~finally:Trans_memo.reset f

(* The GC's [space_overhead] while SafeCheck translates and checks.  Rocq sets
   [space_overhead = 200] for the whole process; during the check the live heap
   is flat while about 1.9 GB/s is allocated, so the heap grows with the
   garbage of a major cycle that lasts minutes.  Measured on LemmaPin_0 with
   cut 1 (runs t200/t80/t40/t20, 2,400 s each, simultaneous on bet64-mem):
   peak 33.17 / 21.96 / 16.75 / 14.70 GiB, 2,450 declarations checked by about
   1,827 / 1,736 / 1,732 / 1,949 s, so 40 costs no time.  GC parameters change
   when memory is reclaimed, never a value, so the checker's result is the
   same. *)
let safecheck_space_overhead = 40

(* Run [f ()] with [safecheck_space_overhead]; the saved GC settings are
   restored when [f] returns or raises, and an exception passes through. *)
let with_safecheck_gc f =
  let saved = Gc.get () in
  Gc.set { saved with Gc.space_overhead = safecheck_space_overhead };
  Fun.protect ~finally:(fun () -> Gc.set saved) f

let safecheck_program ~opaque_access env evm poly term =
  with_trans_memo_reset @@ fun () ->
  let env = safecheck_env env evm poly in
  let prog = time (str"Quoting") (quote_safecheck_program ~opaque_access env evm) term in
  let uctx =
    if poly then
      let uctx = Evd.to_universe_context evm in
      let _inst, auctx = UVars.abstract_universes uctx in
      Ast_quoter.mkPolymorphic_ctx (Ast_quoter.quote_abstract_univ_context auctx)
    else Ast_quoter.mkMonomorphic_ctx ()
  in
  with_safecheck_gc @@ fun () ->
  time (str"Checking")
    (Extraction.infer_and_print_template_program_with_guard
      Config0.default_checker_flags
      (* Config0.type_in_type *)
       prog)
    uctx

(* Sameness of the shared quotation: quote [c] as [MetaRocq SafeCheck] does,
   once with every quoted natural and string built afresh (the quoter before
   they were shared) and once shared, and compare the two programs with
   OCaml's structural equality.  Also check that the shared quoter returns one
   value for repeated naturals and strings. *)
let test_quote_sharing ~opaque_access env evm poly c =
  let env = safecheck_env env evm poly in
  let term = EConstr.to_constr evm c in
  let unshared =
    time (str"Unshared quoting")
      (fun () -> Ast_quoter.with_unshared_quotation
         (fun () -> quote_safecheck_program ~opaque_access env evm term)) ()
  in
  let shared = time (str"Shared quoting") (quote_safecheck_program ~opaque_access env evm) term in
  let equal = time (str"Comparing") (fun () -> unshared = shared) () in
  let physically_shared =
    Ast_quoter.quote_int 7 == Ast_quoter.quote_int 7
    && Ast_quoter.quote_string "x" == Ast_quoter.quote_string "x"
  in
  if equal && physically_shared then
    Feedback.msg_info
      (str "Quote sharing test passed: the shared and unshared quotations are structurally equal.")
  else
    CErrors.user_err
      (str "Quote sharing test failed: structurally equal = " ++ bool equal
       ++ str ", repeated values shared = " ++ bool physically_shared ++ str ".")

(* The first [tCase] node of a quoted program: in its term, else in the body of
   one of its constant declarations. *)
let rec find_case (t : Ast0.term) : Ast0.term option =
  let first l =
    List.fold_left (fun found x -> match found with Some _ -> found | None -> find_case x) None l
  in
  match t with
  | Ast0.Coq_tCase _ -> Some t
  | Ast0.Coq_tEvar (_, l) -> first l
  | Ast0.Coq_tCast (c, _, ty) -> first [c; ty]
  | Ast0.Coq_tProd (_, a, b) | Ast0.Coq_tLambda (_, a, b) -> first [a; b]
  | Ast0.Coq_tLetIn (_, b, ty, b') -> first [b; ty; b']
  | Ast0.Coq_tApp (f, l) -> first (f :: l)
  | Ast0.Coq_tProj (_, c) -> find_case c
  | Ast0.Coq_tFix (m, _) | Ast0.Coq_tCoFix (m, _) ->
    first (List.concat_map (fun d -> [d.BasicAst.dtype; d.BasicAst.dbody]) m)
  | Ast0.Coq_tArray (_, l, d, ty) -> first (l @ [d; ty])
  | _ -> None

let find_case_in_program ((genv, body) : Ast0.Env.program) =
  match find_case body with
  | Some t -> Some t
  | None ->
    List.fold_left (fun found (_, decl) ->
        match found, decl with
        | Some _, _ -> found
        | None, Ast0.Env.ConstantDecl { Ast0.Env.cst_body = Some b; _ } -> find_case b
        | None, _ -> None)
      None genv.Ast0.Env.declarations

(* Sameness of the shared translation, and the environment control.

   Sameness: quote [c] as [MetaRocq SafeCheck] does, translate the program with
   the memoized [trans_program] (the checker's) and with the plain
   [trans_program_unshared], and require [compare a b = 0] and at least one memo
   hit.  ([compare] is total; [=] is false on a NaN primitive float.)

   Environment control: the memo may reuse only values that read no
   environment.  [Σ1] is the empty environment, [Σ2] the translated
   environment of the quoted program; [t] is a [tCase] node of the program, so
   its inductive [I] is in [Σ2] and not in [Σ1]; [w] is a case-free term;
   [u = tApp (f, [t; t; w])] and [v = tApp (g, [w; u])] share [t] and [w]
   physically.  After translating with [trans_shared Σ1], [trans_shared Σ2 x]
   must equal [trans Σ2 x] for (a) [x = t], (b) [x = u] with [t] computed in the
   same call, (c) [x = v] after [w] alone went into the table (so the parent
   meets a table hit and a flagged child together), and [w] must hit across
   [Σ1] and [Σ2].

   The comparison runs on every term.  The environment control runs when the
   quoted program contains a match on an inductive (a [tCase] node), in the
   term itself or in the body of a constant it depends on; the message says
   whether it ran. *)
let trans_environment_control prog t =
  let same a b = Stdlib.compare a b = 0 in
  let genv, _ = prog in
  let sigma1 =
    TemplateToPCUIC.empty_trans_env genv.Ast0.Env.universes genv.Ast0.Env.retroknowledge
  in
  let sigma2 = TemplateToPCUIC.trans_global_env genv in
  let rel n = Ast0.Coq_tRel n in
  let w = Ast0.Coq_tApp (rel Datatypes.O, [rel (Datatypes.S Datatypes.O)]) in
  let u = Ast0.Coq_tApp (rel (Datatypes.S (Datatypes.S Datatypes.O)), [t; t; w]) in
  let v = Ast0.Coq_tApp (rel (Datatypes.S (Datatypes.S (Datatypes.S Datatypes.O))), [w; u]) in
  let shared_tr sigma x = TemplateToPCUICShared.trans_shared sigma x in
  let plain_tr sigma x = TemplateToPCUIC.trans sigma x in
  let checks_under_sigma2 x = same (shared_tr sigma2 x) (plain_tr sigma2 x) in
  (* The control means something only if [t] translates differently under the two environments. *)
  let env_matters = not (same (plain_tr sigma1 t) (plain_tr sigma2 t)) in
  Trans_memo.reset ();
  ignore (shared_tr sigma1 u);
  let case_a = checks_under_sigma2 t in
  Trans_memo.reset ();
  ignore (shared_tr sigma1 u);
  let case_b = checks_under_sigma2 u in
  Trans_memo.reset ();
  ignore (shared_tr sigma1 w);
  ignore (shared_tr sigma1 v);
  let case_c = checks_under_sigma2 v in
  Trans_memo.reset ();
  ignore (shared_tr sigma1 w);
  let hits_w = Trans_memo.hits () in
  let w2 = shared_tr sigma2 w in
  let case_w = Trans_memo.hits () = hits_w + 1 && same w2 (plain_tr sigma2 w) in
  Trans_memo.reset ();
  let verdict ok = str (if ok then "ok" else "FAILED") in
  (env_matters && case_a && case_b && case_c && case_w,
   str "environment control: environment matters " ++ verdict env_matters
   ++ str ", (a) " ++ verdict case_a ++ str ", (b) " ++ verdict case_b
   ++ str ", (c) " ++ verdict case_c ++ str ", w hit across environments " ++ verdict case_w)

let test_trans_sharing ~opaque_access env evm poly c =
  with_trans_memo_reset @@ fun () ->
  let env = safecheck_env env evm poly in
  let term = EConstr.to_constr evm c in
  let prog = time (str"Quoting") (quote_safecheck_program ~opaque_access env evm) term in
  let hits_before = Trans_memo.hits () in
  let shared = time (str"Shared translation") SafeTemplateChecker.trans_program prog in
  let hits = Trans_memo.hits () - hits_before in
  let unshared =
    time (str"Unshared translation") SafeTemplateChecker.trans_program_unshared prog
  in
  let equal = time (str"Comparing") (fun () -> Stdlib.compare shared unshared = 0) () in
  let control_ok, control =
    match find_case_in_program prog with
    | Some t -> trans_environment_control prog t
    | None -> (true, str "environment control: not run, the quoted program has no match")
  in
  let report =
    str "structurally equal = " ++ bool equal ++ str ", memo hits = " ++ Pp.int hits
    ++ str "; " ++ control ++ str "."
  in
  if equal && hits > 0 && control_ok then
    Feedback.msg_info (str "Trans sharing test passed: " ++ report)
  else
    CErrors.user_err (str "Trans sharing test failed: " ++ report)

let check ~opaque_access env evm poly (c, _ustate) =
  debug (fun () -> str"Quoting");
  match safecheck_program ~opaque_access env evm poly (EConstr.to_constr evm c) with
  | Coq_inl s -> Feedback.msg_info (pr_string s)
  | Coq_inr s -> CErrors.user_err (pr_string s)

let string_contains ~where ~what =
  let n = String.length where and m = String.length what in
  let rec search i =
    i + m <= n && (String.equal (String.sub where i m) what || search (i + 1))
  in
  Int.equal m 0 || search 0

(* A negative fixture must be rejected, and rejected for its own reason: the
   checker's message has to contain [reason], which says why the program is
   ill-typed, and [subject], which says of what.  Accepting the program, or
   refusing it for an unrelated reason, fails the test. *)
let expect_safecheck_rejection what reason subject = function
  | Coq_inr s ->
    let message = caml_string_of_bytestring s in
    let missing part =
      not (string_contains ~where:message ~what:part)
    in
    if missing reason || missing subject then
      CErrors.user_err
        (str what ++ str " was rejected, but not for the expected reason."
         ++ fnl () ++ str "expected a message containing: " ++ str reason
         ++ fnl () ++ str "and: " ++ str subject
         ++ fnl () ++ str "got: " ++ str message)
    else
      Feedback.msg_info (str what ++ str " was rejected as expected.")
  | Coq_inl s ->
    CErrors.user_err
      (str what ++ str " was accepted, but it is ill-typed: "
       ++ str (caml_string_of_bytestring s))

(* The declaration is already in the environment and already invalid, so the
   obligation it breaks exists before quotation. *)
let test_safecheck_rejects_source ~opaque_access env evm poly reason subject c =
  expect_safecheck_rejection "The quoted source declaration" reason subject
    (safecheck_program ~opaque_access env evm poly (EConstr.to_constr evm c))

(* A polymorphic declaration whose body is
   [fun (X : Type@{max(Set+1, u)}) => (X : Type@{u})], with a real kernel
   [Cast] and with [u] its own bound universe.  Nothing constrains a bound
   universe, so the cast obligation [max(Set+1, u) <= u] does not hold: an
   instance may set [u] to [Set].  (A declared global universe cannot show
   this: Rocq's graph already holds [Set < u] for each of those, which makes
   [max(Set+1, u) = u] true there.)

   Rocq's surface syntax cannot write an algebraic sort in a binder, so the
   declaration is built here and added to the environment that the quoter
   reads.  The invalid obligation therefore exists before quotation, exactly
   as for a declaration that [Unset Universe Checking] let through. *)
let set_successor_cast_declaration env =
  let bound = Univ.Level.var 0 in
  let algebraic = Univ.Universe.unrepr [Univ.Level.set, 1; bound, 0] in
  let domain = Constr.mkSort (Sorts.make Sorts.Quality.qtype algebraic) in
  let target =
    Constr.mkSort (Sorts.make Sorts.Quality.qtype (Univ.Universe.make bound))
  in
  let body =
    Constr.mkLambda
      (Context.anonR, domain,
       Constr.mkCast (Constr.mkRel 1, Constr.DEFAULTcast, target))
  in
  let typ = Constr.mkProd (Context.anonR, domain, target) in
  let auctx =
    UVars.AbstractContext.make
      { UVars.quals = [||];
        UVars.univs = [| Names.Name (Names.Id.of_string "u") |] }
      PConstraints.empty
  in
  let kn =
    Names.KerName.make
      (Names.ModPath.MPfile
         (Names.DirPath.make
            [Names.Id.of_string "MetaRocq";
             Names.Id.of_string "Regression"]))
      (Names.Label.of_id (Names.Id.of_string "set_successor_cast"))
  in
  let constant_body =
    { Declarations.const_hyps = [];
      const_univ_hyps = UVars.Instance.empty;
      const_body = Declarations.Def body;
      const_type = typ;
      const_relevance = Sorts.Relevant;
      const_body_code = None;
      const_universes = Declarations.Polymorphic auctx;
      const_inline_code = false;
      const_typing_flags = Environ.typing_flags env }
  in
  let constant = Names.Constant.make1 kn in
  (Environ.add_constant constant constant_body env,
   Constr.mkConstU
     (constant, UVars.Instance.of_array ([||], [| Univ.Level.set |])))

let test_set_successor_cast ~opaque_access env evm reason subject =
  let env, term = set_successor_cast_declaration env in
  expect_safecheck_rejection "The max(Set+1, u) cast" reason subject
    (safecheck_program ~opaque_access env evm false term)

(* [bad : Type@{d} := I Type@{d}], where [d] is the template default universe
   of the template inductive [I], read from [I]'s own metadata rather than
   named here.  [Type@{d} : Type@{d+1}], so [I Type@{d}] lives in
   [Type@{d+1}] and the declaration is invalid: checking it needs
   [d+1 <= d].

   The body's head is a template inductive, which is the path where a
   substitution keyed on the body's inferred instance could rewrite the
   declared [d] into the body's larger representative and hand the checker a
   repaired declaration.  The declaration is stored in the environment the
   quoter reads, so the obligation exists before quotation. *)
let declared_default_declaration env ind =
  let mib = Environ.lookup_mind (fst ind) env in
  let template =
    match mib.Declarations.mind_template with
    | Some template -> template
    | None ->
      CErrors.user_err
        (str "This test needs a template-polymorphic inductive.")
  in
  let _, defaults =
    UVars.Instance.to_array template.Declarations.template_defaults
  in
  let default =
    if Int.equal (Array.length defaults) 0 then
      CErrors.user_err
        (str "This test needs a template inductive with a universe parameter.")
    else defaults.(0)
  in
  let declared =
    Constr.mkSort
      (Sorts.make Sorts.Quality.qtype (Univ.Universe.make default))
  in
  let body =
    Constr.mkApp (Constr.mkIndU (ind, UVars.Instance.empty), [| declared |])
  in
  let kn =
    Names.KerName.make
      (Names.ModPath.MPfile
         (Names.DirPath.make
            [Names.Id.of_string "MetaRocq";
             Names.Id.of_string "Regression"]))
      (Names.Label.of_id (Names.Id.of_string "declared_type_successor"))
  in
  let constant_body =
    { Declarations.const_hyps = [];
      const_univ_hyps = UVars.Instance.empty;
      const_body = Declarations.Def body;
      const_type = declared;
      const_relevance = Sorts.Relevant;
      const_body_code = None;
      const_universes = Declarations.Monomorphic;
      const_inline_code = false;
      const_typing_flags = Environ.typing_flags env }
  in
  let constant = Names.Constant.make1 kn in
  (Environ.add_constant constant constant_body env,
   Constr.mkConstU (constant, UVars.Instance.empty))

let test_declared_default ~opaque_access env evm reason subject c =
  let ind =
    match EConstr.kind evm c with
    | Constr.Ind (ind, _) -> ind
    | _ -> CErrors.user_err (str "This test needs an inductive type.")
  in
  let env, term = declared_default_declaration env ind in
  expect_safecheck_rejection
    "The declaration typed at its inductive's default universe" reason subject
    (safecheck_program ~opaque_access env evm false term)

let quote_with_cache quote env term =
  fst (quote () env (Evd.from_env env) term)

let test_cache_typing_flags env evm c =
  let term = EConstr.to_constr evm c in
  let impredicative_env = Environ.set_impredicative_set true env in
  let predicative_env = Environ.set_impredicative_set false env in
  let cached_context = Ast_quoter.make_template_universe_context () in
  let quote, _ =
    Ast_quoter.quote_term_remember ~universe_context:cached_context
      (fun _ () -> ()) (fun _ _ () -> ())
  in
  let first = quote_with_cache quote impredicative_env term in
  let cached = quote_with_cache quote predicative_env term in
  let fresh_context = Ast_quoter.make_template_universe_context () in
  let fresh_quote, _ =
    Ast_quoter.quote_term_remember ~universe_context:fresh_context
      (fun _ () -> ()) (fun _ _ () -> ())
  in
  let fresh = quote_with_cache fresh_quote predicative_env term in
  if cached = fresh && first <> cached then
    Feedback.msg_info (str "Cache typing-flag regression passed.")
  else
    CErrors.user_err
      (str "Cache reused a quotation across changed typing flags.")

let test_safecheck_rejection ~opaque_access env evm c =
  let term = EConstr.to_constr evm c in
  let prog =
    Ast_quoter.quote_term_rec ~translate_template:true ~bypass:true
      ~opaque_access ~with_universes:true env evm term
  in
  let bad_term =
    Ast_quoter.mkSort
      (Ast_quoter.quote_sort
         (Sorts.make Sorts.Quality.qtype Univ.Universe.type0))
  in
  let bad_name =
    Ast_quoter.quote_kn
      (Names.KerName.make
         (Names.ModPath.MPfile
            (Names.DirPath.make
               [Names.Id.of_string "MetaRocq";
                Names.Id.of_string "Regression"]))
         (Names.Label.of_id (Names.Id.of_string "successor_too_low")))
  in
  let bad_decl =
    Ast_quoter.mk_constant_decl
      (Ast_quoter.mk_constant_body bad_term (Some bad_term)
         (Ast_quoter.mkMonomorphic_ctx ())
         (Ast_quoter.quote_relevance Sorts.Relevant))
  in
  let global_env, quoted_term = prog in
  let bad_program =
    ({ global_env with declarations = (bad_name, bad_decl) :: global_env.declarations },
     quoted_term)
  in
  match
    Extraction.infer_and_print_template_program_with_guard
      Config0.default_checker_flags bad_program (Ast_quoter.mkMonomorphic_ctx ())
  with
  | Coq_inr _ ->
    Feedback.msg_info (str "SafeCheck negative regression passed.")
  | Coq_inl _ ->
    CErrors.user_err
      (str "SafeCheck accepted a successor-too-low quoted declaration.")

}


VERNAC COMMAND EXTEND MetaRocqSafeCheck CLASSIFIED AS QUERY STATE opaque_access
| #[ poly = polymorphic ] [ "MetaRocq" "SafeCheck" constr(c) ] -> {
    let env = Global.env () in
    let evm = Evd.from_env env in
    let c = Constrintern.interp_constr env evm c in
    check env evm poly c
  }
END

VERNAC COMMAND EXTEND MetaRocqTestCacheTypingFlags CLASSIFIED AS QUERY
| [ "MetaRocq" "Test" "Cache" "Typing" "Flags" constr(c) ] -> {
    let env = Global.env () in
    let evm = Evd.from_env env in
    let c, _ = Constrintern.interp_constr env evm c in
    test_cache_typing_flags env evm c
  }
END

VERNAC COMMAND EXTEND MetaRocqTestSafeCheckRejection CLASSIFIED AS QUERY STATE opaque_access
| [ "MetaRocq" "Test" "SafeCheck" "Rejects" constr(c) ] -> {
    let env = Global.env () in
    let evm = Evd.from_env env in
    let c, _ = Constrintern.interp_constr env evm c in
    test_safecheck_rejection env evm c
  }
END

VERNAC COMMAND EXTEND MetaRocqTestSafeCheckRejectsSource CLASSIFIED AS QUERY STATE opaque_access
| #[ poly = polymorphic ] [ "MetaRocq" "Test" "SafeCheck" "Rejects" "Source" string(reason) string(subject) constr(c) ] -> {
    let env = Global.env () in
    let evm = Evd.from_env env in
    let c, _ = Constrintern.interp_constr env evm c in
    test_safecheck_rejects_source env evm poly reason subject c
  }
END

VERNAC COMMAND EXTEND MetaRocqTestQuoterSetSuccessorCast CLASSIFIED AS QUERY STATE opaque_access
| [ "MetaRocq" "Test" "Quoter" "Set" "Successor" "Cast" string(reason) string(subject) ] -> {
    let env = Global.env () in
    let evm = Evd.from_env env in
    test_set_successor_cast env evm reason subject
  }
END

VERNAC COMMAND EXTEND MetaRocqTestQuoterDeclaredDefault CLASSIFIED AS QUERY STATE opaque_access
| [ "MetaRocq" "Test" "Quoter" "Declared" "Default" string(reason) string(subject) constr(c) ] -> {
    let env = Global.env () in
    let evm = Evd.from_env env in
    let c, _ = Constrintern.interp_constr env evm c in
    test_declared_default env evm reason subject c
  }
END

VERNAC COMMAND EXTEND MetaRocqTestQuoteSharing CLASSIFIED AS QUERY STATE opaque_access
| #[ poly = polymorphic ] [ "MetaRocq" "Test" "Quote" "Sharing" constr(c) ] -> {
    let env = Global.env () in
    let evm = Evd.from_env env in
    let c, _ = Constrintern.interp_constr env evm c in
    test_quote_sharing env evm poly c
  }
END

VERNAC COMMAND EXTEND MetaRocqTestTransSharing CLASSIFIED AS QUERY STATE opaque_access
| #[ poly = polymorphic ] [ "MetaRocq" "Test" "Trans" "Sharing" constr(c) ] -> {
    let env = Global.env () in
    let evm = Evd.from_env env in
    let c, _ = Constrintern.interp_constr env evm c in
    test_trans_sharing env evm poly c
  }
END


{

let retypecheck_term_dependencies ~opaque_access env gr =
  let typecheck env c = ignore (Typeops.infer env c) in
  let typecheck_constant c =
    let auctx = Environ.constant_context env c in
    let {UVars.quals = qnames; UVars.univs = unames} as names = UVars.AbstractContext.names auctx in
    let dp = Names.DirPath.make [Names.Id.of_string "MetaRocq"; Names.Id.of_string "Retypecheck"] in
    let fake_quality i _ =
      Sorts.Quality.QVar (Sorts.QVar.make_unif "" i)
    in
    let fake_level i _ =
     Univ.Level.make (Univ.UGlobal.make dp "" i)
    in
    let fake_inst = UVars.Instance.of_array (Array.mapi fake_quality qnames, Array.mapi fake_level unames) in
    let cu = (c, fake_inst) in
    let cbody, ctype, cstrs = Environ.constant_value_and_type env cu in
    let env' = Environ.push_context (UVars.UContext.make names (fake_inst, cstrs)) env in
    typecheck env' ctype;
    Option.iter (typecheck env') cbody
  in
  let st = Conv_oracle.get_transp_state (Environ.oracle (Global.env())) in
  let _theory, deps = Assumptions.assumptions ~add_opaque:true ~add_transparent:true opaque_access
      st [gr] in
  let process_object k _ty =
    let open Printer in
    match k with
    | Variable id -> debug (fun () -> str "Ignoring variable " ++ Names.Id.print id)
    | Axiom (ax, _) ->
      begin match ax with
        | Constant c -> typecheck_constant c
        | Positive mi -> () (* typecheck_inductive mi *)
        | Guarded (Names.GlobRef.ConstRef c) -> typecheck_constant c
        | Guarded _ -> ()
        | TypeInType c -> ()
        | UIP _ -> ()
      end
    | Opaque c | Transparent c -> typecheck_constant c
  in Printer.ContextObjectMap.iter process_object deps

let kern_check ~opaque_access env evm gr =
  try
    let () = time (str"Rocq kernel checking") (retypecheck_term_dependencies ~opaque_access env) gr in
    Feedback.msg_info (Printer.pr_global gr ++ str " and all its dependencies are well-typed.")
  with e -> raise e
}

VERNAC COMMAND EXTEND MetaRocqRocqCheck CLASSIFIED AS QUERY STATE opaque_access
| [ "MetaRocq" "RocqCheck" global(c) ] -> {
    let env = Global.env () in
    let evm = Evd.from_env env in
    kern_check env evm (Nametab.global c)
  }
END
